! =============================================================================
! RiverObs CalVal config -- orthomosaic water mask -> RiverTile
! SWORD v16   (pair with SWOT RiverSP version C / PIC0)
! -----------------------------------------------------------------------------
! Passed as the `rdf_file` argument to calval2rivertile.py. Format is
! "key (units) = value"; calval2rivertile.py runs ast.literal_eval on every
! value except a short list of string-valued keys, so lists and booleans are
! written in Python syntax.
! =============================================================================

! --- prior river database -----------------------------------------------------
! Path to the SWORD netCDF, or to a DIRECTORY of SWORD netCDFs (RiverObs will
! pick the tiles that intersect the water mask bounding box). RiverObs reads
! the netCDF distribution, NOT the .shp you are currently using in script 3.4.
!
! Use the ORIGINAL release file. No padding needed: RiverObs returns masked
! arrays for the variables it declares but the public SWORD release does not
! carry, and derives /reaches/type from reach_id when it is absent.
reach_db_path             (-) = /Users/camryn/Desktop/SWORD_v16/na_sword_v16.nc

! The legacy shapefile width database is not used.
width_db_file             (-) = None
use_width_db              (-) = False

! --- pixel selection ----------------------------------------------------------
! Must match class_value in SimplePixelCloud.from_airborne_imagery (default 4).
class_list                (-) = [4]

! Every water cell contributes its full cell area. The digitized mask is
! binary, so there is no sub-pixel water fraction to apply.
use_fractional_inundation (-) = [False]

! Connected-component segmentation on the water mask's own grid. Leave True:
! SWOTRiverEstimator always passes a max_width to RiverObs, and RiverObs's
! flag_out_channel_and_label() calls .copy() on the segmentation labels, so
! setting this False raises AttributeError rather than disabling segmentation.
use_segmentation          (-) = [True]
preseg_dilation_iter      (-) = 0

! Heights in the pixel cloud are all zero -- this run is for area and width
! only. wse, wse_u, and slope in the output RiverTile are meaningless and must
! not be used. Set True anyway; the False path leaves every node with no
! height pixels and is not exercised upstream.
use_heights               (-) = [True]

! --- node aggregation ---------------------------------------------------------
! 'orig' makes node area = sum(pixel_area) over assigned cells and node width =
! that area / SWORD p_length -- i.e. exactly the definition in your current
! manuscript, computed by RiverObs's own RiverNode.width_area(). The
! 'composite' method is designed around SWOT's water fraction, sig0, and edge
! classes, none of which a digitized mask has, so 'orig' is both simpler and
! more defensible here.
area_agg_method           (-) = orig
! MUST also be 'orig'. RiverObs only skips get_node_agg() when height AND area
! are both 'orig'; any other value sends it into the interferometric height
! aggregator, which needs phase_noise_std / dh_dphi -- variables a water mask
! does not have. Verified: 'median' here raises
!   AttributeError: 'RiverNode' object has no attribute 'phase_noise_std'
height_agg_method         (-) = orig

! Cross-channel search corridor. RiverObs scales this per node by SWORD
! max_width and ext_dist_coef; scalar_max_width is only the fallback for nodes
! with no usable prior width.
scalar_max_width          (-) = 600.0
use_ext_dist_coef         (-) = True

! --- centerline ---------------------------------------------------------------
! ds = None keeps SWORD's own node spacing, so output node_id values match
! RiverSP one-to-one and the join in script 3.3 stays a plain key join.
ds                        (-) = None
refine_centerline         (-) = False
smooth                    (-) = 0.01
alpha                     (-) = 1
max_iter                  (-) = 1

! --- node / reach population thresholds ---------------------------------------
! min_points is the minimum pixel count for a tile to be processed at all;
! minobs is the minimum assigned cells for a node to be reported. At 3 m
! spacing a 200 m node in a 50 m wide river holds ~1100 cells, so minobs=10 is
! permissive by design -- you want thin coverage reported and then filtered
! explicitly in step 4, not silently dropped here.
min_points                (-) = 100
minobs                    (-) = 10
! Set far above any real node count so every WSE/slope fit is skipped. The
! pixel cloud has constant zero heights, so wse_r_u is 0, so the fit weights
! (1/wse_r_u^2) are infinite and statsmodels raises
!   numpy.linalg.LinAlgError: SVD did not converge
! None of these fits touch area or width -- reach width comes from mask_area,
! not mask_wse.
min_fit_points            (-) = 1000000
trim_ends                 (-) = False

! --- WSE / slope machinery, disabled ------------------------------------------
! Constant-zero heights, so outlier rejection and the Bayesian slope fit have
! nothing to work on. 'first_to_last' is the cheapest slope path.
outlier_method            (-) = None
slope_method              (-) = first_to_last
use_multiple_reaches      (-) = False

! --- quality flags ------------------------------------------------------------
! A digitized mask carries no PIXC quality information, so every threshold is
! zero and every cell is treated as good.
pixc_qual_handling        (-) = None
geo_qual_wse_suspect      (-) = 0
geo_qual_wse_degraded     (-) = 0
geo_qual_wse_bad          (-) = 0
class_qual_area_suspect   (-) = 0
class_qual_area_degraded  (-) = 0
class_qual_area_bad       (-) = 0
sig0_qual_suspect         (-) = 0
sig0_qual_bad             (-) = 0
num_good_sus_pix_thresh_wse  (-) = 1
num_good_sus_pix_thresh_area (-) = 1
use_bright_land           (-) = True
! Percent-of-good-nodes threshold for reach masking. Every water-mask cell is
! good, so pct_good_sus is always 100 and any value below that is neutral.
! Must be present: without it SWOTRiverEstimator gets None and get_reach_mask()
! raises TypeError comparing float <= None.
reach_pct_good_sus_thresh (-) = 0

! --- geolocation --------------------------------------------------------------
! No-op for the CalVal path; present so load_config finds the keys.
do_improved_geolocation   (-) = False
geolocation_method        (-) = taylor
clip_buffer               (-) = 0.1
